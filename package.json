{
  "name": "alka-traders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build:backend": "cd backend && npm install --include=dev && npx prisma generate && npx tsc",
    "build": "npm run build:backend && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/prerender.mjs --dist frontend/dist && node scripts/copy-frontend.mjs",
    "build:frontend": "node ./node_modules/vite/bin/vite.js build",
    "build:frontend:full": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/prerender.mjs --dist frontend/dist && node scripts/copy-frontend.mjs",
    "start": "node server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:backend": "npm --prefix backend test",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "seo:audit": "node scripts/seo-audit.mjs",
    "index:audit": "node scripts/index-audit.mjs",
    "seo:urls": "node scripts/url-list.mjs",
    "catalog:audit": "node scripts/catalog-seo-audit.mjs",
    "gsc:audit": "node scripts/gsc-index-audit.mjs",
    "seo:prerender": "node scripts/prerender.mjs --dist frontend/dist",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/react": "^10.65.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cloudinary": "^2.10.0",
    "cobe": "^2.0.1",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "papaparse": "^5.5.4",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "three": "^0.184.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "proxy-addr": "^2.0.8",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.2",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.2.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
