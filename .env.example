[TEMPLATE]
# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Vite automatically exposes vars prefixed with VITE_

# API base URL — points at the backend (api) Railway service.
# In production this is the *.railway.app URL of your backend service
# (or your custom domain once DNS is pointed at Railway).
# During local dev the vite proxy in vite.config.ts forwards /api to
# http://localhost:3001, so VITE_API_URL can stay http://localhost:5173.
VITE_API_URL=https://api-xxx.railway.app

# Default site theme: "light" or "dark" (light unless overridden)
# Users can still switch with the theme toggle; their choice is persisted.
VITE_DEFAULT_THEME=light

# ─── SSR Rate-limit Exemption ─────────────────────────────────
# Shared secret between the web service and the api service (see
# backend/.env.example). Read at RUNTIME by server.js — it is not
# VITE_-prefixed, so it is never inlined into the browser bundle. server.js
# sends it as the x-ssr-token header so the API's public limiter exempts the
# frontend's server-to-server catalog fetches; a Googlebot burst must not
# become 503 + noindex pages (SEO_RANKING_RESEARCH.md §1).
# Generate with: openssl rand -hex 32 — MUST be identical on both services.
SSR_API_TOKEN=

# ─── Important ─────────────────────────────────────────────────
# Do NOT put backend secrets here (JWT_SECRET, DATABASE_URL, PayPal,
# Cloudinary, SMTP, etc.). Those belong on the backend Railway service
# only. Vite inlines every VITE_* variable into the frontend bundle.
# Only public, non-secret config goes in this file.
#
# ─── Deployment (Railway + GitHub) ────────────────────────────
# This repo is deployed to Railway via the GitHub integration.
# Push to `master` → Railway auto-deploys the `web` and `api` services.
# See RAILWAY_DEPLOY.md for the full setup steps.
