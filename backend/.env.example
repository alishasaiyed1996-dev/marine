[TEMPLATE]
# ═══════════════════════════════════════════════════════════════
# Alka Traders — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Required vars are validated at startup (env.ts); the server refuses
# to boot in production if JWT_SECRET or DATABASE_URL are missing.
# ═══════════════════════════════════════════════════════════════

# ─── Database (Railway PostgreSQL) ───────────────────────────
# Get these from your Railway PostgreSQL service's "Connect" / Variables tab.
# Both vars receive the SAME connection string on Railway (there is no
# separate pooler vs direct endpoint like Neon). SSL is on by default.
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/dbname
DIRECT_URL=postgresql://postgres:password@host.railway.app:5432/dbname

# ─── Auth (JWT) ───────────────────────────────────────────────
# Required in production. Use a random 64-char hex (or longer) string.
JWT_SECRET=change-this-to-a-random-64-char-hex-string-in-production
# Used for CSRF double-submit cookie signing. Falls back to JWT_SECRET if unset.
CSRF_SECRET=change-this-to-a-random-64-char-hex-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── SSR Rate-limit Exemption ─────────────────────────────────
# Shared secret between the api service and the "marine" web service.
# server.js sends it as the x-ssr-token header on its server-to-server
# catalog fetches, and publicLimiter skips those read-only GETs instead of
# counting them against the 100 req/min public limit. Without it a Googlebot
# burst over ~1,100 product URLs turns into 429s that the frontend renders as
# 503 + noindex pages (SEO_RANKING_RESEARCH.md §1).
# Generate with: openssl rand -hex 32 — the value MUST be identical on both
# services. Unset (local dev) the limiter behaves as before.
SSR_API_TOKEN=

# ─── Admin Seed Credentials (first-run only) ──────────────────
# Used by `npx tsx prisma/seed.ts`. Admin password MUST be set.
ADMIN_EMAIL=admin@alkatraders.co
ADMIN_NAME=Store Owner
ADMIN_PASSWORD=change-me

# ─── Server ───────────────────────────────────────────────────
# IMPORTANT: set NODE_ENV=production on the host — development disables
# secure cookies, uses lax JWT validation, and uses dev rate limits.
NODE_ENV=development
# Usually unset on Railway — the platform sets PORT automatically.
PORT=3001

# ─── Origin / CORS (REQUIRED in production) ───────────────────
# Comma-separated list of origins allowed to call the API with credentials.
# Include your frontend's domain (custom or *.railway.app).
# Canonical frontend is the non-www apex — www is not attached to Railway.
CORS_ORIGIN=https://alkatraders.co
# Frontend URL — used for PayPal return URLs, password-reset links, emails.
FRONTEND_URL=https://alkatraders.co
# Admin panel base (used by some admin email links / references).
ADMIN_URL=https://alkatraders.co/admin

# ─── PayPal Payments ──────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# sandbox | live
PAYPAL_MODE=sandbox
# Required to verify webhook signatures in production.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ─── Email Delivery ───────────────────────────────────────────
# Preferred on Railway, which blocks outbound SMTP ports (25/465/587/2525).
# Create a key at resend.com and verify the EMAIL_FROM domain. When set, the
# HTTPS API is used instead of SMTP.
# RESEND_API_KEY=re_your_api_key
# SMTP (Hostinger / any SMTP provider; works when the host allows outbound SMTP):
SMTP_HOST=smtp.example.com
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
SMTP_PORT=465
# Set to "false" to use STARTTLS on port 587 instead of implicit TLS on 465.
SMTP_SECURE=true
# From address for all outbound emails. Must be a verified sender/domain.
EMAIL_FROM=sales@alkatraders.co
# Primary inbound routing for contact form / offer notifications.
SALES_EMAIL=sales@alkatraders.co
# RFQ and emergency alerts are also sent to these inboxes when configured.
RFQ_EMAIL=sales@alkatraders.co
EMERGENCY_EMAIL=sales@alkatraders.co

# ─── Store Defaults ───────────────────────────────────────────
WHATSAPP_NUMBER=918799095041
COMPANY_PHONE=+9714XXXXXXX
COMPANY_EMAIL=sales@alkatraders.co
COMPANY_NAME=Alka Traders
DEFAULT_SHIPPING_COST=25
DEFAULT_TAX_RATE=0.08
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=AE

# ─── Image / File Hosting ─────────────────────────────────────
# Cloudinary URL (product images, media library, avatars, etc.).
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Logging & Monitoring ─────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ─── eBay Marketplace Integration (roadmap C) ─────────────────
# From developer.ebay.com (see MANUAL_TASKS.md MT-5). Without these the
# eBay scheduler idles and admin eBay routes return 503 — the rest of the
# app is unaffected.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# User-context OAuth token — REQUIRED by the Sell APIs (inventory, fulfillment).
# Mint once via developer.ebay.com → Application Keys → "User Tokens" →
# Get a User Token (OAuth). Long string starting with v^1.1#...
EBAY_REFRESH_TOKEN=
# Webhook endpoint verification (Event Notification Platform challenge).
EBAY_VERIFICATION_TOKEN=
# Full notification endpoint URL — MUST match the URL registered on eBay
# exactly: it is an input to the SHA-256 challenge hash
# (sha256(challenge_code + verificationToken + endpoint)).
EBAY_PUBLIC_ENDPOINT=https://api.alkatraders.co/api/webhooks/ebay
# Account-level references required to publish offers.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Trading API site (0 = EBAY_US) and catalog/import tuning.
# The importer creates DRAFT products; images are mirrored to Cloudinary.
EBAY_SITE_ID=0
EBAY_IMPORT_BATCH_SIZE=4
EBAY_IMPORT_MAX_IMAGES=6

# ─── E2E Testing ──────────────────────────────────────────────
# Set to any value to bypass rate limits during Playwright tests.
PLAYWRIGHT_TEST=
