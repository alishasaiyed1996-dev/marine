# ─── Storefront (Railway "marine" web service) ────────────────────────────
# Copy to .env for local development and fill in real values. NEVER commit a
# filled-in copy: .env / .env.* are gitignored on purpose.
#
# Secrets below are generated with:
#   openssl rand -base64 48   (long secrets)
#   openssl rand -hex 32      (tokens)

# Node runtime
NODE_ENV=development
PORT=3000

# Canonical public origin of the storefront. The canonical HOST for the
# http→https and www→apex redirects (server.js) is derived from this value —
# its hostname must be the apex form (e.g. alkatraders.co, NOT www.…).
VITE_SITE_URL=http://localhost:5173

# API base URL consumed by the browser (and by server.js SSR fetches).
VITE_API_URL=http://localhost:4000
# Frontend URL variant used by tooling/config (kept in sync with VITE_SITE_URL).
VITE_FRONTEND_URL=http://localhost:5173

# SSR → API shared token. MUST be the same value on the api service; without
# it, SSR catalog fetches count against the public 100 req/min/IP limiter.
SSR_API_TOKEN=replace-with-openssl-rand-hex-32
# Bounded timeout for SSR API fetches (ms).
SSR_API_TIMEOUT_MS=8000

# Browser error monitoring (B5). Leave empty to disable Sentry entirely —
# the SDK only initializes when this is set.
VITE_SENTRY_DSN=

# Build metadata stamped into Sentry releases.
VITE_APP_VERSION=

# Default color scheme: "dark" or "light" (default).
VITE_DEFAULT_THEME=light

# Set to 1 to log API request/response diagnostics during development.
VITE_API_DEBUG=
