# ─── API backend (Railway "api" service) ──────────────────────────────────
# Copy to .env for local development and fill in real values. NEVER commit a
# filled-in copy: .env / .env.* are gitignored on purpose.
#
# JWT_SECRET, CSRF_SECRET and ADMIN_PASSWORD are denylist-protected: in
# production the server REFUSES TO BOOT if their value matches the SHA-256 of
# a secret that was committed to git history (backend/src/utils/env.ts).
# Generate new ones with:  openssl rand -base64 48
#
# H-2 (argon_seo audit) operational notes:
#   - JWT_SECRET and CSRF_SECRET protect DIFFERENT mechanisms. The CSRF key
#     only falls back to JWT_SECRET when it is unset — never rely on that in
#     production; the two values must be DISTINCT random strings.
#   - Rotate ADMIN_PASSWORD and any secret whose value was ever stored in a
#     local .env copy (treat every local machine copy as exposed). Rotation
#     happens in the provider dashboard (Railway), then update the local copy.

# Node runtime
NODE_ENV=development
NODE_VERSION=22
PORT=4000

# ─── Database (required) ──────────────────────────────────────────────────
# Postgres connection string. DIRECT_URL is used by prisma migrate.
DATABASE_URL=postgresql://user:password@localhost:5432/alka_traders
DIRECT_URL=postgresql://user:password@localhost:5432/alka_traders

# ─── Secrets (required, denylist-protected) ───────────────────────────────
# JWT signing key. Required in production — the server refuses to boot without it.
JWT_SECRET=replace-with-openssl-rand-base64-48
# CSRF double-submit token signing. Falls back to JWT_SECRET when unset.
CSRF_SECRET=replace-with-openssl-rand-base64-48
# Initial admin password used by prisma/seed.ts ONLY (seeding the first admin).
# Rotating this value does NOT change an existing admin's password — change it
# in the admin UI. Still denylist-protected at boot.
ADMIN_PASSWORD=replace-with-openssl-rand-base64-48
ADMIN_EMAIL=admin@example.com
# Admin panel URL (kept for reference/redirects).
ADMIN_URL=http://localhost:5173/admin

# Token lifetimes
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CUSTOMER_TOKEN_EXPIRES_IN=1h

# ─── URLs / CORS ──────────────────────────────────────────────────────────
# Public storefront origin. Drives PayPal return URLs, password-reset links,
# email buttons, sitemap base and CORS. Never localhost in production.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins.
CORS_ORIGIN=http://localhost:5173

# SSR → API shared token. MUST be set identically on the storefront ("marine")
# service; read-only GET requests carrying it are exempt from the public limiter.
SSR_API_TOKEN=replace-with-openssl-rand-hex-32

# ─── Email (Resend over HTTPS — the only transport) ────────────────────────
# RESEND_API_KEY is required or emails are queued as 'skipped' and NOT sent.
# The sending domain must be verified in the Resend dashboard (SPF/DKIM).
# Replies go to the From/Reply-To mailbox — no SMTP settings are used anywhere.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=sales@example.com
SALES_EMAIL=sales@example.com
RFQ_EMAIL=
EMERGENCY_EMAIL=
COMPANY_EMAIL=sales@example.com
COMPANY_NAME=Alka Traders
COMPANY_PHONE=
WHATSAPP_NUMBER=

# ─── Storefront defaults ──────────────────────────────────────────────────
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=USD
DEFAULT_SHIPPING_COST=25
DEFAULT_TAX_RATE=0.08

# ─── Payments (PayPal) ────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id

# ─── eBay integration ─────────────────────────────────────────────────────
EBAY_ENV=sandbox
EBAY_SITE_ID=0
EBAY_CLIENT_ID=replace-with-ebay-client-id
EBAY_CLIENT_SECRET=replace-with-ebay-client-secret
EBAY_REFRESH_TOKEN=replace-with-ebay-refresh-token
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_PUBLIC_ENDPOINT=
EBAY_VERIFICATION_TOKEN=
# Catalog auto-sync: walks the account's ActiveList every sweep (default 5
# minutes, floor 60 s) and imports newly listed items so the website mirrors
# eBay within minutes. 1 = on (default).
EBAY_AUTOSYNC_INTERVAL_MS=300000
# Auto-publish newly imported products through the same publish gate the admin
# UI enforces (1 = on, default). 0 keeps new imports as admin-published drafts.
EBAY_AUTO_PUBLISH=1
# Optional eBay leaf-category ID → website category slug pins, e.g.
# {"29506":"engine-parts"}. Pinned IDs win over name/keyword mapping; unknown
# slugs are ignored with a warning. See docs/ebay-catalog-sync.md.
EBAY_CATEGORY_ID_MAP=

# ─── Media (Cloudinary) ───────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Error monitoring (B5) ────────────────────────────────────────────────
# Leave empty to disable Sentry entirely — the SDK only initializes when set.
SENTRY_DSN=

# ─── Logging ──────────────────────────────────────────────────────────────
# pino level: debug | info | warn | error (defaults to info in production).
LOG_LEVEL=
